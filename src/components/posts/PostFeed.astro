---
import type { PublicPost } from '../../lib/posts/types';
import PostCard from './PostCard.astro';
import PostSearch from './PostSearch.astro';
import TagFilter from './TagFilter.astro';

interface Props {
  posts: PublicPost[];
  tags: string[];
  title: string;
  variant: 'home' | 'posts';
  headingId?: string;
  id?: string;
  showSearch?: boolean;
}

const { posts, tags, title, variant, headingId, id, showSearch = true } = Astro.props;
const hasSidebar = Astro.slots.has('sidebar');
---

<section class:list={['post-feed', `post-feed--${variant}`]} id={id} data-post-feed aria-labelledby={headingId} aria-label={headingId ? undefined : '글 목록'}>
  <header class="post-feed-header">
    {variant === 'posts' ? (
      <div>
        <p>RECORDS</p>
        <h1 id={headingId}>{title}</h1>
      </div>
    ) : <h2 id={headingId}>{title}</h2>}
    <span>{posts.length}개의 글</span>
  </header>
  {showSearch && <PostSearch className={variant === 'posts' ? 'posts-search' : 'journal-search'} />}
  <TagFilter tags={tags} postCount={posts.length} />
  {posts.length === 0 ? <p class="post-feed-empty">아직 공개된 글이 없습니다.</p> : hasSidebar ? (
    <div class="journal-content">
      <div class="post-grid">
        {posts.map((post, index) => <PostCard post={post} index={index} headingLevel={3} tone={index % 6} />)}
      </div>
      <aside class="journal-sidebar"><slot name="sidebar" /></aside>
    </div>
  ) : (
    <div class="post-grid">
      {posts.map((post, index) => <PostCard post={post} index={index} headingLevel={2} />)}
    </div>
  )}
  <div class="post-feed-sentinel" data-post-sentinel aria-hidden="true"></div>
</section>

<script>
  document.querySelectorAll<HTMLElement>('[data-post-feed]').forEach((feed) => {
    const cards = Array.from(feed.querySelectorAll<HTMLElement>('[data-post-card]'));
    const filters = Array.from(feed.querySelectorAll<HTMLButtonElement>('[data-tag-filter]'));
    const sentinel = feed.querySelector<HTMLElement>('[data-post-sentinel]');
    const searchInput = feed.querySelector<HTMLInputElement>('[data-search]');
    const batchSize = 15;
    let activeTag = 'all';
    let searchQuery = '';
    let visibleCount = batchSize;

    const renderCards = () => {
      let matchedCount = 0;

      cards.forEach((card) => {
        const tagMatches = activeTag === 'all' || card.dataset.tags?.split('|').includes(activeTag);
        const searchableText = `${card.textContent ?? ''} ${card.dataset.tags ?? ''}`.toLocaleLowerCase('ko-KR');
        const matches = tagMatches && (!searchQuery || searchableText.includes(searchQuery));
        card.hidden = !matches || matchedCount >= visibleCount;
        if (matches) matchedCount += 1;
      });

      if (sentinel) sentinel.hidden = matchedCount <= visibleCount;
    };

    filters.forEach((filter) => {
      filter.addEventListener('click', () => {
        activeTag = filter.dataset.tagFilter ?? 'all';
        visibleCount = batchSize;
        filters.forEach((button) => {
          const selected = button === filter;
          button.classList.toggle('is-active', selected);
          button.setAttribute('aria-pressed', String(selected));
        });
        renderCards();
      });
    });

    searchInput?.addEventListener('input', () => {
      searchQuery = searchInput.value.trim().toLocaleLowerCase('ko-KR');
      visibleCount = batchSize;
      renderCards();
    });

    if (sentinel) {
      new IntersectionObserver((entries) => {
        if (entries.some((entry) => entry.isIntersecting)) {
          visibleCount += batchSize;
          renderCards();
        }
      }, { rootMargin: '300px' }).observe(sentinel);
    }
  });
</script>

<style is:global>
  .post-feed--home .post-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:18px}.post-feed--home .post-card{min-width:0}.post-feed--home .post-card>a{position:relative;display:block;aspect-ratio:.72;overflow:hidden;border-radius:16px;background:#d9e3f1;color:#fff}.post-feed--home .post-card-image{position:absolute;inset:0;display:grid;place-items:center;background:linear-gradient(145deg,#8fc9e7,#edf2e7 52%,#5e8eb0)}.post-feed--home .post-card-image[data-tone='1']{background:linear-gradient(145deg,#82888c,#d1cab9 52%,#484944)}.post-feed--home .post-card-image[data-tone='2']{background:linear-gradient(145deg,#f5f5f1,#c9d6bd 52%,#557155)}.post-feed--home .post-card-image img{width:100%;height:100%;object-fit:cover}.post-feed--home .post-card-image span{padding:16px;color:#2d3945;font-size:11px;font-weight:700;text-align:center}.post-feed--home .post-card-image::after{position:absolute;inset:0;background:linear-gradient(180deg,transparent 35%,rgba(11,16,22,.72));content:''}.post-feed--home .post-card-copy{position:absolute;z-index:1;right:19px;bottom:18px;left:19px;padding:0}.post-feed--home .post-card-copy p{margin:0 0 11px}.post-feed--home .post-card-copy time{display:inline-block;border-radius:7px;background:rgba(255,255,255,.9);padding:6px 8px;color:#30343c;font-size:11px;font-weight:600}.post-feed--home .post-card-copy h2,.post-feed--home .post-card-copy h3{display:-webkit-box;overflow:hidden;margin:0;color:#fff;font-size:21px;line-height:1.28;letter-spacing:-.055em;-webkit-box-orient:vertical;-webkit-line-clamp:3}@media(max-width:700px){.post-feed--home .post-grid{grid-template-columns:1fr;gap:14px}.post-feed--home .post-card>a{aspect-ratio:1.15}.post-feed--home .post-card-copy h2,.post-feed--home .post-card-copy h3{font-size:24px}}
</style>
