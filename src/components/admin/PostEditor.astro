---
interface Props { postId?: string; }
const { postId } = Astro.props;
---

<section class="admin-editor-workspace" data-post-editor data-post-id={postId ?? ''}>
  <header class="admin-editor-header">
    <a href="/admin/posts" class="admin-back-link">← 글 목록</a>
    <div class="admin-editor-actions"><span data-editor-status>새 초안</span><span data-save-state>저장 전</span><button type="button" class="secondary" data-archive hidden>보관</button><button type="button" class="secondary" data-save>저장</button><button type="button" class="primary" data-publish>발행</button></div>
  </header>
  <form data-post-form>
    <div class="admin-editor-tabs" role="tablist" aria-label="작성 보기">
      <button type="button" role="tab" aria-selected="true" data-view-tab="edit">편집</button><button type="button" role="tab" aria-selected="false" data-view-tab="preview">미리보기</button>
    </div>
    <div class="admin-editor-grid">
      <section class="admin-writing-surface" data-edit-view>
        <label class="admin-title-field"><span class="sr-only">제목</span><input name="title" maxlength="90" required placeholder="제목을 입력하세요" /></label>
        <section class="admin-tiptap" aria-label="본문 편집기">
          <div class="admin-tiptap-toolbar" role="toolbar" aria-label="본문 서식"><button type="button" data-editor-action="bold" aria-label="굵게"><strong>B</strong></button><button type="button" data-editor-action="italic" aria-label="기울임"><em>I</em></button><button type="button" data-editor-action="strike" aria-label="취소선"><s>S</s></button><i></i><button type="button" data-editor-action="heading">제목</button><button type="button" data-editor-action="bulletList">목록</button><button type="button" data-editor-action="orderedList">번호</button><button type="button" data-editor-action="blockquote">인용</button><button type="button" data-editor-action="codeBlock">코드</button></div>
          <div data-tiptap-editor></div>
          <div class="admin-insert-actions"><button type="button" data-media-open="body">이미지 넣기</button><span>본문에 이미지를 업로드하거나 라이브러리에서 선택합니다.</span></div>
          <div class="admin-selection-toolbar" data-selection-toolbar hidden role="toolbar" aria-label="선택한 텍스트 서식"><button type="button" data-editor-action="bold"><strong>B</strong></button><button type="button" data-editor-action="italic"><em>I</em></button><button type="button" data-link-action>링크</button><button type="button" data-editor-action="heading">제목</button></div>
          <div class="admin-slash-menu" data-slash-menu hidden role="menu" aria-label="블록 추가"><p>블록 추가</p><button type="button" data-slash-action="paragraph" role="menuitem">본문 <small>일반 문단</small></button><button type="button" data-slash-action="heading" role="menuitem">제목 <small>섹션 제목</small></button><button type="button" data-slash-action="bulletList" role="menuitem">목록 <small>글머리 기호</small></button><button type="button" data-slash-action="blockquote" role="menuitem">인용 <small>인용문</small></button><button type="button" data-slash-action="codeBlock" role="menuitem">코드 <small>코드 블록</small></button><button type="button" data-slash-action="image" role="menuitem">이미지 <small>미디어 라이브러리</small></button></div>
        </section>
      </section>
      <aside class="admin-inspector" aria-label="글 정보">
        <div class="admin-inspector-heading"><div><p>POST SETTINGS</p><h2>글 정보</h2></div><button type="button" data-inspector-toggle aria-expanded="true">접기</button></div>
        <div data-inspector-content>
          <label>카테고리<select name="categoryId" required data-category-select></select></label><label>주소<input name="slug" maxlength="120" placeholder="자동 생성" pattern="[a-z0-9]+(-[a-z0-9]+)*" /></label><label>요약<textarea name="summary" maxlength="240" rows="4" placeholder="목록과 공유 화면에 표시할 짧은 소개"></textarea></label><label>태그 <span>쉼표로 구분</span><input name="tags" maxlength="480" placeholder="기록, 도구, 생각" /></label><section class="admin-cover-field" aria-label="표지 이미지"><strong>표지 이미지 <span>선택 사항</span></strong><img data-cover-preview hidden alt="선택한 표지 이미지 미리보기" /><div><button type="button" data-media-open="cover">이미지 선택</button><input name="coverImageUrl" type="url" placeholder="이미지 URL 붙여넣기" /></div></section>
          <dl class="admin-editor-stats"><div><dt>글자 수</dt><dd data-char-count>0</dd></div><div><dt>읽기 시간</dt><dd data-read-time>1분</dd></div></dl>
          <div class="admin-publish-check"><strong>발행 전 확인</strong><ul><li data-check="title">제목</li><li data-check="category">카테고리</li><li data-check="content">본문</li></ul></div>
        </div>
      </aside>
      <section class="admin-preview-surface" data-preview-view hidden aria-label="글 미리보기"><div class="admin-preview-inner"><p data-preview-category>미리보기</p><h1 data-preview-title>제목을 입력하세요</h1><p data-preview-summary></p><img data-preview-cover hidden alt="" /><div data-preview-content class="essay-body"></div></div></section>
    </div>
    <p class="admin-feedback" data-feedback aria-live="polite"></p>
  </form>
  <section class="admin-media-picker" data-media-picker hidden role="dialog" aria-modal="true" aria-label="이미지 선택">
    <div class="admin-media-picker-card"><header><div><p>MEDIA LIBRARY</p><h2 data-media-picker-title>본문 이미지</h2></div><button type="button" data-media-close aria-label="이미지 선택 창 닫기">×</button></header><label class="admin-media-upload">새 이미지 업로드<input type="file" accept="image/jpeg,image/png,image/webp,image/gif,image/avif" data-media-file /></label><label>대체 텍스트<input data-media-alt maxlength="240" placeholder="이미지를 설명하세요" /></label><p data-media-feedback aria-live="polite"></p><div class="admin-media-grid" data-media-grid></div></div>
  </section>
</section>

<script>
  import { Editor, Mark, Node, type JSONContent } from '@tiptap/core';
  import StarterKit from '@tiptap/starter-kit';
  type Status = 'draft'|'published'|'archived'; type Category={id:string;name:string}; type Doc=JSONContent;
  type Post={id:string;title:string;slug:string;summary:string;status:Status;categoryId:string|null;categoryName:string|null;tags:string[];updatedAt:string;contentJson?:Doc;coverImageUrl?:string|null}; type MediaAsset={id:string;publicUrl:string;originalFilename:string;altText:string}; type ApiResult<T>={ok:true;data:T}|{ok:false;error:{code:string;message:string;fields?:Record<string,string>}};
  const root=document.querySelector<HTMLElement>('[data-post-editor]')!; const form=root.querySelector<HTMLFormElement>('[data-post-form]')!; const feedback=root.querySelector<HTMLElement>('[data-feedback]')!; const categorySelect=root.querySelector<HTMLSelectElement>('[data-category-select]')!; const status=root.querySelector<HTMLElement>('[data-editor-status]')!; const saveState=root.querySelector<HTMLElement>('[data-save-state]')!; const archive=root.querySelector<HTMLButtonElement>('[data-archive]')!; const editView=root.querySelector<HTMLElement>('[data-edit-view]')!; const previewView=root.querySelector<HTMLElement>('[data-preview-view]')!;
  const ImageNode=Node.create({name:'image',group:'block',atom:true,addAttributes(){return{src:{default:null},alt:{default:''}}},parseHTML(){return[{tag:'img[src]'}]},renderHTML({HTMLAttributes}){return['figure',{},['img',HTMLAttributes],['figcaption',{},HTMLAttributes.alt]]}}); const LinkMark=Mark.create({name:'link',inclusive:false,addAttributes(){return{href:{default:null}}},parseHTML(){return[{tag:'a[href]'}]},renderHTML({HTMLAttributes}){return['a',{...HTMLAttributes,rel:'noreferrer'}]}});
  const editor=new Editor({element:root.querySelector<HTMLElement>('[data-tiptap-editor]')!,extensions:[StarterKit.configure({heading:{levels:[1,2,3]}}),ImageNode,LinkMark],content:{type:'doc',content:[{type:'paragraph'}]},editorProps:{attributes:{class:'admin-tiptap-content'}}});
  let selected:Post|null=null; let categories:Category[]=[]; let dirty=false; let autoSaveTimer:ReturnType<typeof setTimeout>|undefined; let slashFrom:number|null=null; let slashIndex=0; let mediaTarget:'body'|'cover'='body';
  const request=async<T,>(url:string,init?:RequestInit):Promise<T>=>{const headers=new Headers(init?.headers);if(!(init?.body instanceof FormData)&&!headers.has('Content-Type'))headers.set('Content-Type','application/json');const response=await fetch(url,{...init,credentials:'same-origin',headers});const raw=await response.text();let body:ApiResult<T>;try{body=JSON.parse(raw) as ApiResult<T>;}catch{throw new Error(response.status===401?'관리자 로그인 세션이 만료되었습니다. 페이지를 새로고침해 다시 로그인해 주세요.':`저장 요청이 실패했습니다. (${response.status})`);}if(!body.ok)throw new Error(body.error.message);return body.data;}; const statusLabel=(value:Status)=>({draft:'초안',published:'발행됨',archived:'보관됨'})[value];
  function input(name:string){return form.elements.namedItem(name) as HTMLInputElement|HTMLTextAreaElement|HTMLSelectElement;} function updateStats(){const chars=editor.getText().trim().replace(/\s+/g,'').length;root.querySelector('[data-char-count]')!.textContent=`${chars.toLocaleString()}자`;root.querySelector('[data-read-time]')!.textContent=`${Math.max(1,Math.ceil(chars/500))}분`;root.querySelector('[data-check="title"]')!.classList.toggle('is-ready',Boolean(input('title').value.trim()));root.querySelector('[data-check="category"]')!.classList.toggle('is-ready',Boolean(categorySelect.value));root.querySelector('[data-check="content"]')!.classList.toggle('is-ready',chars>0);}
  function markDirty(){dirty=true;saveState.textContent='저장 전';updateStats();renderPreview();if(autoSaveTimer)clearTimeout(autoSaveTimer);autoSaveTimer=setTimeout(()=>void autoSave(),1500);} function payload(){const values=new FormData(form);const cover=String(values.get('coverImageUrl')??'').trim();return{title:String(values.get('title')??'').trim(),summary:String(values.get('summary')??'').trim(),categoryId:String(values.get('categoryId')??''),slug:String(values.get('slug')??'').trim()||undefined,tags:String(values.get('tags')??'').split(',').map(tag=>tag.trim()).filter(Boolean),coverImageUrl:cover||null,contentJson:editor.getJSON()};}
  function appendNode(parent:HTMLElement,node:JSONContent){if(node.type==='text'){let current:HTMLElement=document.createElement('span');current.textContent=node.text??'';(node.marks??[]).forEach(mark=>{const next=document.createElement(mark.type==='bold'?'strong':mark.type==='italic'?'em':mark.type==='strike'?'s':mark.type==='code'?'code':'span');next.append(current);current=next;});parent.append(current);return;}if(node.type==='image'){const figure=document.createElement('figure');const image=document.createElement('img');image.src=String(node.attrs?.src??'');image.alt=String(node.attrs?.alt??'');figure.append(image);if(image.alt){const caption=document.createElement('figcaption');caption.textContent=image.alt;figure.append(caption)}parent.append(figure);return;} const tag=({paragraph:'p',heading:node.attrs?.level===3?'h3':'h2',bulletList:'ul',orderedList:'ol',listItem:'li',blockquote:'blockquote',codeBlock:'pre',hardBreak:'br'} as Record<string,string>)[node.type??'']??'div';const element=document.createElement(tag);if(node.type==='codeBlock')element.textContent=(node.content??[]).map(child=>child.text??'').join('');else(node.content??[]).forEach(child=>appendNode(element,child));parent.append(element);}
  function renderCoverPreview(){const image=root.querySelector<HTMLImageElement>('[data-cover-preview]')!;const url=String(input('coverImageUrl').value).trim();image.hidden=!url;if(url)image.src=url;} function renderPreview(){const data=payload();root.querySelector('[data-preview-title]')!.textContent=data.title||'제목을 입력하세요';root.querySelector('[data-preview-summary]')!.textContent=data.summary;root.querySelector('[data-preview-category]')!.textContent=categories.find(category=>category.id===data.categoryId)?.name??'미리보기';const image=root.querySelector<HTMLImageElement>('[data-preview-cover]')!;image.hidden=!data.coverImageUrl;if(data.coverImageUrl)image.src=data.coverImageUrl;renderCoverPreview();const content=root.querySelector<HTMLElement>('[data-preview-content]')!;content.replaceChildren();(data.contentJson.content??[]).forEach(node=>appendNode(content,node));}
  function showPost(post:Post){selected=post;form.reset();input('title').value=post.title;input('summary').value=post.summary;categorySelect.value=post.categoryId??'';input('slug').value=post.slug;input('tags').value=post.tags.join(', ');input('coverImageUrl').value=post.coverImageUrl??'';editor.commands.setContent(post.contentJson??{type:'doc',content:[{type:'paragraph'}]});status.textContent=statusLabel(post.status);archive.hidden=post.status==='archived';dirty=false;saveState.textContent=post.updatedAt?`저장됨 · ${new Intl.DateTimeFormat('ko-KR',{hour:'2-digit',minute:'2-digit',second:'2-digit'}).format(new Date(post.updatedAt))}`:'저장됨';feedback.textContent='';updateStats();renderPreview();}
  async function save(){const data=payload();if(!data.title||!data.categoryId||editor.isEmpty){feedback.textContent='제목, 카테고리, 본문을 입력해 주세요.';return null;}try{feedback.textContent='저장 중…';const post=selected?await request<Post>(`/api/admin/posts/${selected.id}`,{method:'PATCH',body:JSON.stringify(data)}):await request<Post>('/api/admin/posts',{method:'POST',body:JSON.stringify(data)});showPost(post);if(!location.pathname.endsWith(post.id))history.replaceState(null,'',`/admin/posts/${post.id}`);feedback.textContent='저장했습니다.';return post;}catch(cause){feedback.textContent=cause instanceof Error?cause.message:'저장하지 못했습니다.';return null;}}
  async function autoSave(){if(!dirty||!input('title').value.trim()||!categorySelect.value||editor.isEmpty)return;const post=await save();if(!post)return;const time=new Intl.DateTimeFormat('ko-KR',{hour:'2-digit',minute:'2-digit',second:'2-digit'}).format(new Date(post.updatedAt));saveState.textContent=`자동 저장됨 · ${time}`;feedback.textContent='';}
  async function transition(action:'publish'|'archive'){const post=await save();if(!post)return;try{const updated=await request<Post>(`/api/admin/posts/${post.id}/${action}`,{method:'POST',body:'{}'});showPost(updated);feedback.textContent=action==='publish'?'발행했습니다.':'보관했습니다.';}catch(cause){feedback.textContent=cause instanceof Error?cause.message:'상태를 변경하지 못했습니다.';}}
  function setView(view:'edit'|'preview'){const preview=view==='preview';editView.hidden=preview;previewView.hidden=!preview;root.querySelectorAll<HTMLButtonElement>('[data-view-tab]').forEach(button=>button.setAttribute('aria-selected',String(button.dataset.viewTab===view)));if(preview)renderPreview();}
  async function load(){try{const data=await request<{categories:Category[]}>('/api/admin/posts');categories=data.categories;categorySelect.replaceChildren(...categories.map(category=>{const option=document.createElement('option');option.value=category.id;option.textContent=category.name;return option;}));const id=root.dataset.postId;if(id)showPost(await request<Post>(`/api/admin/posts/${id}`));else{categorySelect.value=categories[0]?.id??'';updateStats();renderPreview();}}catch(cause){feedback.textContent=cause instanceof Error?cause.message:'편집기를 불러오지 못했습니다.';}}
  const selectionToolbar=root.querySelector<HTMLElement>('[data-selection-toolbar]')!; const slashMenu=root.querySelector<HTMLElement>('[data-slash-menu]')!; const slashActions=[...root.querySelectorAll<HTMLButtonElement>('[data-slash-action]')]; const mediaPicker=root.querySelector<HTMLElement>('[data-media-picker]')!; const mediaGrid=root.querySelector<HTMLElement>('[data-media-grid]')!; const mediaAlt=root.querySelector<HTMLInputElement>('[data-media-alt]')!; const mediaFeedback=root.querySelector<HTMLElement>('[data-media-feedback]')!;
  function updateSlashSelection(){slashActions.forEach((button,index)=>button.classList.toggle('is-active',index===slashIndex));} function closeSlash(){slashFrom=null;slashMenu.hidden=true;} function openMediaPicker(target:'body'|'cover'='body'){closeSlash();mediaTarget=target;root.querySelector('[data-media-picker-title]')!.textContent=target==='cover'?'표지 이미지':'본문 이미지';mediaPicker.hidden=false;mediaAlt.focus();void loadMedia();} function closeMediaPicker(){mediaPicker.hidden=true;if(mediaTarget==='body')editor.commands.focus();}
  function selectMedia(asset:MediaAsset){if(mediaTarget==='cover'){input('coverImageUrl').value=asset.publicUrl;markDirty();closeMediaPicker();return;}const alt=mediaAlt.value.trim()||asset.altText||asset.originalFilename;editor.chain().focus().insertContent({type:'image',attrs:{src:asset.publicUrl,alt}}).run();closeMediaPicker();}
  function renderMedia(items:MediaAsset[]){mediaGrid.replaceChildren(...items.map(asset=>{const button=document.createElement('button');button.type='button';button.className='admin-media-item';button.innerHTML=`<img src="${asset.publicUrl}" alt=""><span>${asset.originalFilename}</span>`;button.addEventListener('click',()=>selectMedia(asset));return button;}));}
  async function loadMedia(){try{mediaFeedback.textContent='이미지를 불러오는 중…';const data=await request<{items:MediaAsset[]}>('/api/admin/media');renderMedia(data.items);mediaFeedback.textContent=data.items.length?'이미지를 선택하면 본문에 삽입합니다.':'라이브러리가 비어 있습니다. 새 이미지를 업로드하세요.';}catch(cause){mediaFeedback.textContent=cause instanceof Error?cause.message:'이미지를 불러오지 못했습니다.';}}
  async function uploadMedia(file:File){try{mediaFeedback.textContent='이미지를 업로드하는 중…';const data=new FormData();data.set('file',file);data.set('alt',mediaAlt.value.trim());const asset=await request<MediaAsset>('/api/admin/media',{method:'POST',headers:{},body:data});mediaFeedback.textContent='업로드했습니다.';selectMedia(asset);}catch(cause){mediaFeedback.textContent=cause instanceof Error?cause.message:'이미지를 업로드하지 못했습니다.';}}
  editor.on('selectionUpdate',({editor:activeEditor})=>{const {from,to,$from}=activeEditor.state.selection;const visible=from!==to&&$from.parent.isTextblock;selectionToolbar.hidden=!visible;if(visible){const coords=activeEditor.view.coordsAtPos(from);const box=root.getBoundingClientRect();selectionToolbar.style.left=`${coords.left-box.left}px`;selectionToolbar.style.top=`${coords.top-box.top-46}px`;}});editor.on('blur',()=>{selectionToolbar.hidden=true;});
  editor.on('transaction',({editor:activeEditor})=>{const {from}=activeEditor.state.selection;const text=activeEditor.state.doc.textBetween(Math.max(0,from-1),from,'');if(text==='/'){slashFrom=from-1;slashIndex=0;updateSlashSelection();slashMenu.hidden=false;const coords=activeEditor.view.coordsAtPos(from);const box=root.getBoundingClientRect();slashMenu.style.left=`${coords.left-box.left}px`;slashMenu.style.top=`${coords.bottom-box.top+8}px`;}else if(slashFrom!==null)closeSlash();});
  function runSlashAction(action:string|undefined){if(slashFrom===null)return;const chain=editor.chain().focus().deleteRange({from:slashFrom,to:slashFrom+1});if(action==='image'){chain.run();closeSlash();openMediaPicker('body');return;}if(action==='heading')chain.toggleHeading({level:2}).run();else if(action==='bulletList')chain.toggleBulletList().run();else if(action==='blockquote')chain.toggleBlockquote().run();else if(action==='codeBlock')chain.toggleCodeBlock().run();else chain.setParagraph().run();closeSlash();} slashActions.forEach(button=>button.addEventListener('click',()=>runSlashAction(button.dataset.slashAction)));editor.view.dom.addEventListener('keydown',event=>{if(slashMenu.hidden)return;if(event.key==='Escape'){event.preventDefault();closeSlash();return;}if(event.key==='ArrowDown'||event.key==='ArrowUp'){event.preventDefault();slashIndex=(slashIndex+(event.key==='ArrowDown'?1:-1)+slashActions.length)%slashActions.length;updateSlashSelection();return;}if(event.key==='Enter'){event.preventDefault();runSlashAction(slashActions[slashIndex]?.dataset.slashAction);}});
  function handleSlashKeydown(event:KeyboardEvent){if(slashMenu.hidden)return;if(event.key==='Escape'){event.preventDefault();event.stopImmediatePropagation();closeSlash();return;}if(event.key==='ArrowDown'||event.key==='ArrowUp'){event.preventDefault();event.stopImmediatePropagation();slashIndex=(slashIndex+(event.key==='ArrowDown'?1:-1)+slashActions.length)%slashActions.length;updateSlashSelection();return;}if(event.key==='Enter'){event.preventDefault();event.stopImmediatePropagation();runSlashAction(slashActions[slashIndex]?.dataset.slashAction);}} editor.view.dom.addEventListener('keydown',handleSlashKeydown,true);
  root.querySelector('[data-media-close]')!.addEventListener('click',closeMediaPicker);mediaPicker.addEventListener('click',event=>{if(event.target===mediaPicker)closeMediaPicker();});root.querySelectorAll<HTMLButtonElement>('[data-media-open]').forEach(button=>button.addEventListener('click',()=>openMediaPicker(button.dataset.mediaOpen==='cover'?'cover':'body')));root.querySelector<HTMLInputElement>('[data-media-file]')!.addEventListener('change',event=>{const file=((event.currentTarget as HTMLInputElement).files??[])[0];if(file)void uploadMedia(file);});root.querySelector('[data-link-action]')!.addEventListener('click',()=>{const href=window.prompt('링크 주소를 입력하세요.');if(!href)return;try{new URL(href);editor.chain().focus().setMark('link',{href}).run()}catch{feedback.textContent='http:// 또는 https:// 주소를 입력해 주세요.';}});
  const inspectorToggle=root.querySelector<HTMLButtonElement>('[data-inspector-toggle]')!;
  root.querySelector('[data-save]')!.addEventListener('click',()=>void save());root.querySelector('[data-publish]')!.addEventListener('click',()=>void transition('publish'));archive.addEventListener('click',()=>void transition('archive'));root.querySelectorAll<HTMLButtonElement>('[data-view-tab]').forEach(button=>button.addEventListener('click',()=>setView(button.dataset.viewTab as 'edit'|'preview')));root.querySelectorAll<HTMLInputElement|HTMLTextAreaElement|HTMLSelectElement>('input, textarea, select').forEach(control=>control.addEventListener('input',markDirty));editor.on('update',markDirty);root.querySelectorAll<HTMLButtonElement>('[data-editor-action]').forEach(button=>button.addEventListener('click',()=>{const action=button.dataset.editorAction;const chain=editor.chain().focus();if(action==='bold')chain.toggleBold().run();if(action==='italic')chain.toggleItalic().run();if(action==='strike')chain.toggleStrike().run();if(action==='heading')chain.toggleHeading({level:2}).run();if(action==='bulletList')chain.toggleBulletList().run();if(action==='orderedList')chain.toggleOrderedList().run();if(action==='blockquote')chain.toggleBlockquote().run();if(action==='codeBlock')chain.toggleCodeBlock().run();if(action==='link'){const href=window.prompt('링크 주소를 입력하세요.');if(href){const selection=window.getSelection();if(selection?.rangeCount){const anchor=document.createElement('a');anchor.href=href;anchor.target='_blank';anchor.rel='noreferrer';try{selection.getRangeAt(0).surroundContents(anchor)}catch{feedback.textContent='링크는 한 번에 하나의 텍스트 범위에만 적용할 수 있습니다.';}}}}}));inspectorToggle.addEventListener('click',()=>{const content=root.querySelector<HTMLElement>('[data-inspector-content]')!;const collapsed=content.hidden=!content.hidden;inspectorToggle.textContent=collapsed?'펼치기':'접기';inspectorToggle.setAttribute('aria-expanded',String(!collapsed));});form.addEventListener('submit',event=>{event.preventDefault();void save();});window.addEventListener('beforeunload',(event)=>{if(dirty)event.preventDefault();});load();
</script>

