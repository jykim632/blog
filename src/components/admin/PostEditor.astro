---
interface Props { postId?: string; }
const { postId } = Astro.props;
---

<section class="admin-editor-workspace" data-post-editor data-post-id={postId ?? ''}>
  <header class="admin-editor-header">
    <a href="/admin/posts" class="admin-back-link">← 글 목록</a>
    <div class="admin-editor-actions"><span data-editor-status>새 초안</span><span data-save-state>저장 전</span><button type="button" class="secondary" data-archive hidden>보관</button><button type="button" class="secondary" data-save>저장</button><button type="button" class="primary" data-publish>발행</button></div>
  </header>
  <form data-post-form>
    <div class="admin-editor-tabs" role="tablist" aria-label="작성 보기">
      <button type="button" role="tab" aria-selected="true" data-view-tab="edit">편집</button><button type="button" role="tab" aria-selected="false" data-view-tab="preview">미리보기</button>
    </div>
    <div class="admin-editor-grid">
      <section class="admin-writing-surface" data-edit-view>
        <label class="admin-title-field"><span class="sr-only">제목</span><input name="title" maxlength="90" required placeholder="제목을 입력하세요" /></label>
        <section class="admin-tiptap" aria-label="본문 편집기">
          <div class="admin-tiptap-toolbar" role="toolbar" aria-label="본문 서식"><button type="button" data-editor-action="bold" aria-label="굵게"><strong>B</strong></button><button type="button" data-editor-action="italic" aria-label="기울임"><em>I</em></button><button type="button" data-editor-action="strike" aria-label="취소선"><s>S</s></button><i></i><button type="button" data-editor-action="heading">제목</button><button type="button" data-editor-action="bulletList">목록</button><button type="button" data-editor-action="orderedList">번호</button><button type="button" data-editor-action="blockquote">인용</button><button type="button" data-editor-action="codeBlock">코드</button></div>
          <div data-tiptap-editor></div>
        </section>
      </section>
      <aside class="admin-inspector" aria-label="글 정보">
        <div class="admin-inspector-heading"><div><p>POST SETTINGS</p><h2>글 정보</h2></div><button type="button" data-inspector-toggle aria-expanded="true">접기</button></div>
        <div data-inspector-content>
          <label>카테고리<select name="categoryId" required data-category-select></select></label><label>주소<input name="slug" maxlength="120" placeholder="자동 생성" pattern="[a-z0-9]+(-[a-z0-9]+)*" /></label><label>요약<textarea name="summary" maxlength="240" rows="4" placeholder="목록과 공유 화면에 표시할 짧은 소개"></textarea></label><label>태그 <span>쉼표로 구분</span><input name="tags" maxlength="480" placeholder="기록, 도구, 생각" /></label><label>표지 이미지 URL <span>선택 사항</span><input name="coverImageUrl" type="url" placeholder="https://…" /></label>
          <dl class="admin-editor-stats"><div><dt>글자 수</dt><dd data-char-count>0</dd></div><div><dt>읽기 시간</dt><dd data-read-time>1분</dd></div></dl>
          <div class="admin-publish-check"><strong>발행 전 확인</strong><ul><li data-check="title">제목</li><li data-check="category">카테고리</li><li data-check="content">본문</li></ul></div>
        </div>
      </aside>
      <section class="admin-preview-surface" data-preview-view hidden aria-label="글 미리보기"><div class="admin-preview-inner"><p data-preview-category>미리보기</p><h1 data-preview-title>제목을 입력하세요</h1><p data-preview-summary></p><img data-preview-cover hidden alt="" /><div data-preview-content class="essay-body"></div></div></section>
    </div>
    <p class="admin-feedback" data-feedback aria-live="polite"></p>
  </form>
</section>

<script>
  import { Editor, type JSONContent } from '@tiptap/core';
  import StarterKit from '@tiptap/starter-kit';
  type Status = 'draft'|'published'|'archived'; type Category={id:string;name:string}; type Doc=JSONContent;
  type Post={id:string;title:string;slug:string;summary:string;status:Status;categoryId:string|null;categoryName:string|null;tags:string[];updatedAt:string;contentJson?:Doc;coverImageUrl?:string|null}; type ApiResult<T>={ok:true;data:T}|{ok:false;error:{code:string;message:string;fields?:Record<string,string>}};
  const root=document.querySelector<HTMLElement>('[data-post-editor]')!; const form=root.querySelector<HTMLFormElement>('[data-post-form]')!; const feedback=root.querySelector<HTMLElement>('[data-feedback]')!; const categorySelect=root.querySelector<HTMLSelectElement>('[data-category-select]')!; const status=root.querySelector<HTMLElement>('[data-editor-status]')!; const saveState=root.querySelector<HTMLElement>('[data-save-state]')!; const archive=root.querySelector<HTMLButtonElement>('[data-archive]')!; const editView=root.querySelector<HTMLElement>('[data-edit-view]')!; const previewView=root.querySelector<HTMLElement>('[data-preview-view]')!;
  const editor=new Editor({element:root.querySelector<HTMLElement>('[data-tiptap-editor]')!,extensions:[StarterKit.configure({heading:{levels:[1,2,3]}})],content:{type:'doc',content:[{type:'paragraph'}]},editorProps:{attributes:{class:'admin-tiptap-content'}}});
  let selected:Post|null=null; let categories:Category[]=[]; let dirty=false;
  const request=async<T,>(url:string,init?:RequestInit):Promise<T>=>{const response=await fetch(url,{headers:{'Content-Type':'application/json',...(init?.headers??{})},...init});const body=await response.json() as ApiResult<T>;if(!body.ok)throw new Error(body.error.message);return body.data;}; const statusLabel=(value:Status)=>({draft:'초안',published:'발행됨',archived:'보관됨'})[value];
  function input(name:string){return form.elements.namedItem(name) as HTMLInputElement|HTMLTextAreaElement|HTMLSelectElement;} function updateStats(){const chars=editor.getText().trim().replace(/\s+/g,'').length;root.querySelector('[data-char-count]')!.textContent=`${chars.toLocaleString()}자`;root.querySelector('[data-read-time]')!.textContent=`${Math.max(1,Math.ceil(chars/500))}분`;root.querySelector('[data-check="title"]')!.classList.toggle('is-ready',Boolean(input('title').value.trim()));root.querySelector('[data-check="category"]')!.classList.toggle('is-ready',Boolean(categorySelect.value));root.querySelector('[data-check="content"]')!.classList.toggle('is-ready',chars>0);}
  function markDirty(){dirty=true;saveState.textContent='저장 전';updateStats();renderPreview();} function payload(){const values=new FormData(form);const cover=String(values.get('coverImageUrl')??'').trim();return{title:String(values.get('title')??'').trim(),summary:String(values.get('summary')??'').trim(),categoryId:String(values.get('categoryId')??''),slug:String(values.get('slug')??'').trim()||undefined,tags:String(values.get('tags')??'').split(',').map(tag=>tag.trim()).filter(Boolean),coverImageUrl:cover||null,contentJson:editor.getJSON()};}
  function appendNode(parent:HTMLElement,node:JSONContent){if(node.type==='text'){let current:HTMLElement=document.createElement('span');current.textContent=node.text??'';(node.marks??[]).forEach(mark=>{const next=document.createElement(mark.type==='bold'?'strong':mark.type==='italic'?'em':mark.type==='strike'?'s':mark.type==='code'?'code':'span');next.append(current);current=next;});parent.append(current);return;} const tag=({paragraph:'p',heading:node.attrs?.level===3?'h3':'h2',bulletList:'ul',orderedList:'ol',listItem:'li',blockquote:'blockquote',codeBlock:'pre',hardBreak:'br'} as Record<string,string>)[node.type??'']??'div';const element=document.createElement(tag);if(node.type==='codeBlock')element.textContent=(node.content??[]).map(child=>child.text??'').join('');else(node.content??[]).forEach(child=>appendNode(element,child));parent.append(element);}
  function renderPreview(){const data=payload();root.querySelector('[data-preview-title]')!.textContent=data.title||'제목을 입력하세요';root.querySelector('[data-preview-summary]')!.textContent=data.summary;root.querySelector('[data-preview-category]')!.textContent=categories.find(category=>category.id===data.categoryId)?.name??'미리보기';const image=root.querySelector<HTMLImageElement>('[data-preview-cover]')!;image.hidden=!data.coverImageUrl;if(data.coverImageUrl)image.src=data.coverImageUrl;const content=root.querySelector<HTMLElement>('[data-preview-content]')!;content.replaceChildren();(data.contentJson.content??[]).forEach(node=>appendNode(content,node));}
  function showPost(post:Post){selected=post;form.reset();input('title').value=post.title;input('summary').value=post.summary;categorySelect.value=post.categoryId??'';input('slug').value=post.slug;input('tags').value=post.tags.join(', ');input('coverImageUrl').value=post.coverImageUrl??'';editor.commands.setContent(post.contentJson??{type:'doc',content:[{type:'paragraph'}]});status.textContent=statusLabel(post.status);archive.hidden=post.status==='archived';dirty=false;saveState.textContent=post.updatedAt?`저장됨 · ${new Intl.DateTimeFormat('ko-KR',{hour:'2-digit',minute:'2-digit'}).format(new Date(post.updatedAt))}`:'저장됨';feedback.textContent='';updateStats();renderPreview();}
  async function save(){const data=payload();if(!data.title||!data.categoryId||!editor.getText().trim()){feedback.textContent='제목, 카테고리, 본문을 입력해 주세요.';return null;}try{feedback.textContent='저장 중…';const post=selected?await request<Post>(`/api/admin/posts/${selected.id}`,{method:'PATCH',body:JSON.stringify(data)}):await request<Post>('/api/admin/posts',{method:'POST',body:JSON.stringify(data)});showPost(post);if(!location.pathname.endsWith(post.id))history.replaceState(null,'',`/admin/posts/${post.id}`);feedback.textContent='저장했습니다.';return post;}catch(cause){feedback.textContent=cause instanceof Error?cause.message:'저장하지 못했습니다.';return null;}}
  async function transition(action:'publish'|'archive'){const post=await save();if(!post)return;try{const updated=await request<Post>(`/api/admin/posts/${post.id}/${action}`,{method:'POST',body:'{}'});showPost(updated);feedback.textContent=action==='publish'?'발행했습니다.':'보관했습니다.';}catch(cause){feedback.textContent=cause instanceof Error?cause.message:'상태를 변경하지 못했습니다.';}}
  function setView(view:'edit'|'preview'){const preview=view==='preview';editView.hidden=preview;previewView.hidden=!preview;root.querySelectorAll<HTMLButtonElement>('[data-view-tab]').forEach(button=>button.setAttribute('aria-selected',String(button.dataset.viewTab===view)));if(preview)renderPreview();}
  async function load(){try{const data=await request<{categories:Category[]}>('/api/admin/posts');categories=data.categories;categorySelect.replaceChildren(...categories.map(category=>{const option=document.createElement('option');option.value=category.id;option.textContent=category.name;return option;}));const id=root.dataset.postId;if(id)showPost(await request<Post>(`/api/admin/posts/${id}`));else{categorySelect.value=categories[0]?.id??'';updateStats();renderPreview();}}catch(cause){feedback.textContent=cause instanceof Error?cause.message:'편집기를 불러오지 못했습니다.';}}
  const inspectorToggle=root.querySelector<HTMLButtonElement>('[data-inspector-toggle]')!;
  root.querySelector('[data-save]')!.addEventListener('click',()=>void save());root.querySelector('[data-publish]')!.addEventListener('click',()=>void transition('publish'));archive.addEventListener('click',()=>void transition('archive'));root.querySelectorAll<HTMLButtonElement>('[data-view-tab]').forEach(button=>button.addEventListener('click',()=>setView(button.dataset.viewTab as 'edit'|'preview')));root.querySelectorAll<HTMLInputElement|HTMLTextAreaElement|HTMLSelectElement>('input, textarea, select').forEach(control=>control.addEventListener('input',markDirty));editor.on('update',markDirty);root.querySelectorAll<HTMLButtonElement>('[data-editor-action]').forEach(button=>button.addEventListener('click',()=>{const action=button.dataset.editorAction;const chain=editor.chain().focus();if(action==='bold')chain.toggleBold().run();if(action==='italic')chain.toggleItalic().run();if(action==='strike')chain.toggleStrike().run();if(action==='heading')chain.toggleHeading({level:2}).run();if(action==='bulletList')chain.toggleBulletList().run();if(action==='orderedList')chain.toggleOrderedList().run();if(action==='blockquote')chain.toggleBlockquote().run();if(action==='codeBlock')chain.toggleCodeBlock().run();}));inspectorToggle.addEventListener('click',()=>{const content=root.querySelector<HTMLElement>('[data-inspector-content]')!;const collapsed=content.hidden=!content.hidden;inspectorToggle.textContent=collapsed?'펼치기':'접기';inspectorToggle.setAttribute('aria-expanded',String(!collapsed));});form.addEventListener('submit',event=>{event.preventDefault();void save();});window.addEventListener('beforeunload',(event)=>{if(dirty)event.preventDefault();});load();
</script>

<style is:global>
  .admin-editor-workspace{width:min(100%,1320px);margin:auto;padding:0 24px 56px}.admin-editor-header{display:flex;align-items:center;justify-content:space-between;gap:20px;padding:22px 0;border-bottom:1px solid var(--bnb-line,#ddd)}.admin-back-link{color:var(--bnb-ink,#222);font-size:14px;font-weight:600;text-decoration:none}.admin-editor-actions{display:flex;align-items:center;gap:9px;color:var(--bnb-muted,#6a6a6a);font-size:12px}.admin-editor-actions button{border-radius:8px;padding:9px 12px;font:700 13px inherit;cursor:pointer}.admin-editor-actions .secondary{border:1px solid var(--bnb-ink,#222);background:#fff;color:var(--bnb-ink,#222)}.admin-editor-actions .primary{border:1px solid var(--bnb,#ff385c);background:var(--bnb,#ff385c);color:#fff}.admin-editor-tabs{display:flex;gap:5px;padding:24px 0 12px;border-bottom:1px solid var(--bnb-line,#ddd)}.admin-editor-tabs button{border:0;border-bottom:2px solid transparent;background:transparent;padding:8px 10px 9px;color:var(--bnb-muted,#6a6a6a);font:700 14px inherit;cursor:pointer}.admin-editor-tabs button[aria-selected="true"]{border-color:var(--bnb-ink,#222);color:var(--bnb-ink,#222)}.admin-editor-grid{display:grid;grid-template-columns:minmax(0,1fr) 290px;gap:42px;padding-top:28px}.admin-writing-surface{min-width:0;max-width:780px;justify-self:center;width:100%}.admin-title-field input{box-sizing:border-box;width:100%;border:0;border-bottom:2px solid var(--bnb-line,#ddd);padding:7px 0 16px;background:transparent;color:var(--bnb-ink,#222);font:700 clamp(30px,4vw,44px)/1.18 inherit;letter-spacing:-.06em;outline:0}.admin-title-field input:focus{border-color:var(--bnb-ink,#222)}.admin-tiptap{margin-top:23px;border:1px solid var(--bnb-line,#ddd);border-radius:14px;background:#fff;overflow:hidden}.admin-tiptap-toolbar{display:flex;align-items:center;gap:3px;overflow:auto;border-bottom:1px solid var(--bnb-line,#ddd);padding:8px}.admin-tiptap-toolbar button{flex:none;border:0;border-radius:5px;background:transparent;padding:7px 9px;color:var(--bnb-ink,#222);font:700 12px inherit;cursor:pointer}.admin-tiptap-toolbar button:hover{background:var(--bnb-soft,#f7f7f7)}.admin-tiptap-toolbar i{width:1px;height:18px;margin:0 3px;background:var(--bnb-line,#ddd)}.admin-tiptap-content{min-height:500px;padding:26px;color:var(--bnb-ink,#222);font:16px/1.85 inherit;outline:0}.admin-tiptap-content p{margin:0 0 1.2em}.admin-tiptap-content h2{margin:1.7em 0 .7em;font-size:1.55em;line-height:1.25}.admin-tiptap-content h3{margin:1.5em 0 .65em;font-size:1.25em}.admin-tiptap-content ul,.admin-tiptap-content ol{margin:0 0 1.2em;padding-left:1.5em}.admin-tiptap-content blockquote{margin:1.5em 0;border-left:3px solid var(--bnb,#ff385c);padding:4px 0 4px 16px;color:var(--bnb-muted,#6a6a6a)}.admin-tiptap-content pre{overflow:auto;margin:1.5em 0;border-radius:7px;background:#222;padding:16px;color:#fff;font:13px/1.6 ui-monospace,SFMono-Regular,monospace}.admin-tiptap-content.ProseMirror-focused{box-shadow:inset 0 0 0 2px var(--bnb-ink,#222)}.admin-inspector{align-self:start;border:1px solid var(--bnb-line,#ddd);border-radius:14px;background:#fff;padding:18px}.admin-inspector-heading{display:flex;align-items:start;justify-content:space-between;gap:10px;padding-bottom:14px;border-bottom:1px solid var(--bnb-line,#ddd)}.admin-inspector-heading p{margin:0 0 5px;color:var(--bnb-muted,#6a6a6a);font:10px/1 ui-monospace,SFMono-Regular,monospace;letter-spacing:.1em}.admin-inspector-heading h2{margin:0;font-size:16px}.admin-inspector-heading button{border:0;background:transparent;padding:2px;color:var(--bnb-muted,#6a6a6a);font:12px inherit;cursor:pointer}.admin-inspector label{display:block;margin-top:16px;color:var(--bnb-ink,#222);font-size:12px;font-weight:700}.admin-inspector label span{color:var(--bnb-muted,#6a6a6a);font-weight:400}.admin-inspector input,.admin-inspector textarea,.admin-inspector select{box-sizing:border-box;display:block;width:100%;margin-top:7px;border:1px solid var(--bnb-line,#ddd);border-radius:8px;padding:9px 10px;background:#fff;color:var(--bnb-ink,#222);font:13px/1.5 inherit}.admin-inspector textarea{resize:vertical}.admin-inspector input:focus,.admin-inspector textarea:focus,.admin-inspector select:focus{outline:2px solid var(--bnb-ink,#222);outline-offset:1px}.admin-editor-stats{display:grid;grid-template-columns:1fr 1fr;gap:8px;margin:19px 0 0}.admin-editor-stats div{border-radius:8px;background:var(--bnb-soft,#f7f7f7);padding:10px}.admin-editor-stats dt{color:var(--bnb-muted,#6a6a6a);font-size:11px}.admin-editor-stats dd{margin:4px 0 0;font-size:14px;font-weight:700}.admin-publish-check{margin-top:18px;padding-top:16px;border-top:1px solid var(--bnb-line,#ddd);font-size:12px}.admin-publish-check ul{display:grid;gap:6px;margin:10px 0 0;padding:0;list-style:none;color:var(--bnb-muted,#6a6a6a)}.admin-publish-check li::before{content:'○';margin-right:7px}.admin-publish-check li.is-ready{color:var(--bnb-ink,#222)}.admin-publish-check li.is-ready::before{content:'●';color:var(--bnb,#ff385c)}.admin-preview-surface{grid-column:1/-1}.admin-preview-inner{max-width:780px;margin:0 auto;padding:16px 0 60px}.admin-preview-inner>p:first-child{margin:0 0 10px;color:var(--bnb,#ff385c);font-size:13px;font-weight:700}.admin-preview-inner h1{margin:0;font-size:clamp(34px,5vw,54px);line-height:1.12;letter-spacing:-.06em}.admin-preview-inner>p:not(:first-child){margin:18px 0 28px;color:var(--bnb-muted,#6a6a6a);font-size:17px;line-height:1.65}.admin-preview-inner img{display:block;width:100%;max-height:420px;object-fit:cover;border-radius:14px;margin:0 0 32px}.essay-body{font-size:17px;line-height:1.9}.essay-body p{margin:0 0 1.25em}.essay-body h2{margin:1.8em 0 .7em;font-size:1.6em;line-height:1.3}.essay-body h3{margin:1.5em 0 .65em;font-size:1.28em}.essay-body ul,.essay-body ol{padding-left:1.5em}.essay-body blockquote{margin:1.5em 0;border-left:3px solid var(--bnb,#ff385c);padding-left:16px;color:var(--bnb-muted,#6a6a6a)}.essay-body pre{overflow:auto;border-radius:8px;background:#222;padding:16px;color:#fff}.admin-feedback{min-height:20px;margin:14px 0;color:var(--bnb-muted,#6a6a6a);font-size:13px}@media(max-width:860px){.admin-editor-workspace{padding:0 20px 42px}.admin-editor-grid{grid-template-columns:1fr;gap:24px}.admin-inspector{grid-row:2}.admin-preview-surface{grid-row:1}.admin-tiptap-content{min-height:360px}}@media(max-width:620px){.admin-editor-header{align-items:start;flex-direction:column}.admin-editor-actions{width:100%;flex-wrap:wrap}.admin-editor-actions span:first-child{margin-right:auto}.admin-editor-grid{padding-top:20px}.admin-inspector{padding:15px}.admin-tiptap-content{padding:20px}.admin-title-field input{font-size:31px}}
  /* 편집과 미리보기는 모두 중앙 콘텐츠 + 우측 Inspector를 사용한다. */
  @media (min-width:861px){
    .admin-inspector{grid-column:2;grid-row:1}
    .admin-preview-surface{grid-column:1;grid-row:1;min-width:0}
  }
</style>
