---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteFooter from '../components/SiteFooter.astro';
import SiteHeader from '../components/SiteHeader.astro';
---

<BaseLayout title="여백의 기록 — JY의 블로그" description="천천히 보고, 오래 남기는 생각의 기록.">
  <SiteHeader />
  <main id="top">
    <section class="post-index" id="writing" aria-labelledby="writing-title">
      <p class="eyebrow">WRITING</p>
      <h1 id="writing-title">글</h1>
      <div class="post-list">
        <article class="post post-amber">
          <a href="/posts/good-tools-are-quiet">
            <p class="post-number">01 / 2026.07.16</p>
            <h2>좋은 도구는<br />나를 더 조용하게<br />만든다</h2>
            <div><span>WORK &amp; CRAFT</span><span>읽기</span></div>
          </a>
        </article>
      </div>
    </section>
  </main>
  <SiteFooter />
</BaseLayout>
