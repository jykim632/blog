---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteFooter from '../components/SiteFooter.astro';
import SiteHeader from '../components/SiteHeader.astro';
import PostFeed from '../components/posts/PostFeed.astro';
import TagFilter from '../components/posts/TagFilter.astro';
import { env } from 'cloudflare:workers';
import { listPublishedPosts } from '../../functions/api/admin/posts/repository';

const posts = await listPublishedPosts((env as never as { DB: Parameters<typeof listPublishedPosts>[0] }).DB);
const tags = [...new Set(posts.flatMap((post) => post.tags))].sort((a, b) => a.localeCompare(b, 'ko'));
const featuredPosts = posts.slice(0, 3);
const formatDate = (value: string) => new Date(value).toLocaleDateString('ko-KR', { year: 'numeric', month: 'long', day: 'numeric' });
---

<BaseLayout title="파랑새들의 둥지" description="일과 기술, 그리고 오래 붙잡고 싶은 장면을 기록합니다." bodyClass="journal-home">
  <SiteHeader />
  <div class="journal-shell">
    <main id="top" class="journal-frame">
      <header class="journal-hero">
        <p>RECORDS</p>
        <h1>새로운 기록을<br />발견해 보세요</h1>
        <span>일과 기술, 그리고 오래 붙잡고 싶은 장면을<br />파랑새들의 둥지에 차곡차곡 담습니다.</span>
      </header>
      <PostFeed posts={posts} tags={tags} title="새로 도착한 기록" variant="home" headingId="records-title" id="writing" showTags={false}>
        <Fragment slot="sidebar">
          <section class="home-tags" aria-labelledby="tags-title">
            <h2 id="tags-title">Topics</h2>
            <TagFilter tags={tags} postCount={posts.length} collapsible />
          </section>
          <section class="home-featured" aria-labelledby="featured-title">
            <h2 id="featured-title">Featured</h2>
            {featuredPosts.length ? (
              <div class="home-featured-list">
                {featuredPosts.map((post, index) => (
                  <a href={`/posts/${post.slug}`}>
                    <span class:list={['home-featured-image', `tone-${index % 3}`]}>{post.coverImageUrl ? <img src={post.coverImageUrl} alt="" loading="lazy" /> : <i>{post.categoryName ?? 'RECORDS'}</i>}</span>
                    <span><time datetime={post.publishedAt}>{formatDate(post.publishedAt)}</time><strong>{post.title}</strong></span>
                  </a>
                ))}
              </div>
            ) : <p class="home-featured-empty">발행된 기록이 생기면<br />이곳에 추천 글을 보여드릴게요.</p>}
          </section>
          <section class="home-latest"><h2>Latest</h2><a href="/posts">최근 기록 전체 보기 <span aria-hidden="true">→</span></a></section>
        </Fragment>
      </PostFeed>
    </main>
  </div>
  <SiteFooter />

  <style is:global>
    .journal-home{--journal-ink:#171924;--journal-blue:#3469e7;--journal-line:#e7e7ea;--journal-muted:#747784;--journal-canvas:#f2f2f3;background:var(--journal-canvas);color:var(--journal-ink)}.journal-shell{width:min(calc(100vw - 48px),1400px);margin:40px auto 0;overflow:hidden;border:1px solid var(--journal-line);border-radius:28px 28px 0 0;background:#fff}.journal-frame{padding:0 72px 76px}.journal-hero{min-height:400px;padding:78px 20px 45px;background:radial-gradient(circle at 50% 45%,rgba(244,247,255,.8),transparent 52%),linear-gradient(120deg,transparent 0 19%,rgba(235,237,245,.75) 19.1% 19.3%,transparent 19.4% 100%);text-align:center}.journal-hero>p{display:inline-block;margin:0 0 24px;border-radius:999px;background:#f3f4f7;padding:7px 11px;font-size:12px;font-weight:600}.journal-hero h1{margin:0;font-size:clamp(38px,4vw,56px);line-height:1.15;letter-spacing:-.065em}.journal-hero>span{display:block;margin-top:20px;color:#5b606d;font-size:17px;line-height:1.6;letter-spacing:-.025em}.journal-home .post-feed{max-width:none;margin:0;padding:28px 0 0}.journal-home .post-feed-header{display:flex;align-items:center;gap:12px;padding:0 0 18px}.journal-home .post-feed-header h2,.home-featured h2,.home-latest h2{display:flex;align-items:center;gap:12px;margin:0;font-size:25px;line-height:1.25;letter-spacing:-.055em}.journal-home .post-feed-header h2::after,.home-featured h2::after,.home-latest h2::after{height:1px;flex:1;background:var(--journal-line);content:''}.journal-home .post-feed-header>span{display:none}.journal-home .post-search.journal-search{display:flex;align-items:center;gap:10px;width:min(100%,620px);height:50px;margin:0 auto 22px;border:1px solid #dedfe5;border-radius:12px;background:#fff;padding:0 15px;box-shadow:0 1px 2px rgba(16,24,40,.03)}.journal-home .post-search.journal-search>span{font-size:22px;line-height:1}.journal-home .post-search.journal-search input{width:100%;border:0;outline:0;color:var(--journal-ink);font:14px Pretendard,system-ui,sans-serif}.journal-home .post-tags{display:flex;gap:8px;margin:0 0 26px;padding:0;overflow:auto}.journal-home .post-tags button{flex:none;border:1px solid var(--journal-line);border-radius:999px;background:#fff;padding:8px 12px;color:#646875;font:500 13px/1 Pretendard,system-ui,sans-serif}.journal-home .post-tags button.is-active{border-color:var(--journal-blue);background:var(--journal-blue);color:#fff}.journal-home .journal-content{display:grid;grid-template-columns:minmax(0,1fr) 310px;gap:28px}.journal-home .post-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:18px}.journal-home .post-card{min-width:0}.journal-home .post-card[hidden]{display:none}.journal-home .post-card>a{position:relative;display:block;aspect-ratio:.72;overflow:hidden;border-radius:16px;background:#d9e3f1;color:#fff}.journal-home .post-card-image{position:absolute;inset:0;display:grid;place-items:center;background:linear-gradient(145deg,#8fc9e7,#edf2e7 52%,#5e8eb0)}.journal-home .post-card-image[data-tone='1']{background:linear-gradient(145deg,#82888c,#d1cab9 52%,#484944)}.journal-home .post-card-image[data-tone='2']{background:linear-gradient(145deg,#f5f5f1,#c9d6bd 52%,#557155)}.journal-home .post-card-image img{width:100%;height:100%;object-fit:cover}.journal-home .post-card-image span{padding:16px;color:#2d3945;font-size:11px;font-weight:700;text-align:center}.journal-home .post-card-image::after{position:absolute;inset:0;background:linear-gradient(180deg,transparent 35%,rgba(11,16,22,.72));content:''}.journal-home .post-card-copy{position:absolute;z-index:1;right:19px;bottom:18px;left:19px}.journal-home .post-card-copy p{margin:0 0 11px}.journal-home .post-card-copy time{display:inline-block;border-radius:7px;background:rgba(255,255,255,.9);padding:6px 8px;color:#30343c;font-size:11px;font-weight:600}.journal-home .post-card-copy h3{display:-webkit-box;overflow:hidden;margin:0;color:#fff;font-size:21px;line-height:1.28;letter-spacing:-.055em;-webkit-box-orient:vertical;-webkit-line-clamp:3}.journal-home .journal-sidebar{border-left:1px solid var(--journal-line);padding-left:28px}.home-featured-list{display:grid;gap:18px;margin-top:18px}.home-featured-list>a{display:grid;grid-template-columns:92px minmax(0,1fr);gap:14px;align-items:center}.home-featured-image{display:grid;aspect-ratio:1;place-items:center;overflow:hidden;border-radius:13px;background:#e2e8f3}.home-featured-image img{width:100%;height:100%;object-fit:cover}.home-featured-image i{padding:8px;color:#5f697a;font-size:10px;font-style:normal;font-weight:700;text-align:center}.home-featured-image.tone-1{background:#dfd7c8}.home-featured-image.tone-2{background:#d7e3d1}.home-featured-list time{display:block;margin-bottom:7px;color:#989ba4;font-size:12px}.home-featured-list strong{display:-webkit-box;overflow:hidden;font-size:17px;line-height:1.35;letter-spacing:-.045em;-webkit-box-orient:vertical;-webkit-line-clamp:3}.home-featured-empty{margin:18px 0 0;border-radius:12px;background:#f5f6f8;padding:22px;color:#777c87;font-size:14px;line-height:1.6}.home-latest{margin-top:34px}.home-latest a{display:block;margin-top:17px;color:#666a74;font-size:14px}.home-latest a span{margin-left:7px}.journal-home .post-feed-empty{margin:0;border:1px solid var(--journal-line);border-radius:16px;background:linear-gradient(135deg,#f5f7ff,#fff);padding:72px 24px;color:#737887;text-align:center}.journal-home footer{width:min(calc(100vw - 48px),1400px);margin:0 auto;border:1px solid var(--journal-line);border-top:0;background:#fff;padding-inline:72px;color:#777b86}@media(max-width:1050px){.journal-shell{width:min(calc(100vw - 32px),1400px);margin-top:16px}.journal-frame{padding-inline:36px}.journal-home .journal-content{grid-template-columns:1fr}.journal-home .journal-sidebar{display:grid;grid-template-columns:1fr 1fr;gap:30px;border-top:1px solid var(--journal-line);border-left:0;padding:28px 0 0}.home-latest{margin-top:0}.journal-home footer{width:min(calc(100vw - 32px),1400px);padding-inline:36px}}@media(max-width:700px){.journal-shell{width:100%;margin-top:0;border-width:0 0 1px;border-radius:0}.journal-frame{padding:0 20px 50px}.journal-hero{min-height:340px;padding:60px 0 35px}.journal-hero h1{font-size:36px}.journal-hero>span{font-size:15px}.journal-home .post-feed{padding-top:24px}.journal-home .post-feed-header h2{font-size:23px}.journal-home .post-grid{grid-template-columns:1fr;gap:14px}.journal-home .post-card>a{aspect-ratio:1.15}.journal-home .post-card-copy h3{font-size:24px}.journal-home .journal-sidebar{display:block;margin-top:26px}.home-latest{margin-top:28px}.journal-home footer{width:100%;padding-inline:20px}}
    .journal-home,.journal-home input,.journal-home button{font-family:system-ui,-apple-system,BlinkMacSystemFont,"Apple SD Gothic Neo","Noto Sans KR",sans-serif!important}.journal-home{background:#fff}.journal-shell{width:min(calc(100vw - 48px),1280px);margin-top:0;border:0}.journal-frame{padding-inline:24px}.journal-home footer{width:min(calc(100vw - 48px),1280px);border:0;padding-inline:24px}@media(max-width:700px){.journal-shell,.journal-home footer{width:100%}.journal-frame{padding-inline:20px}}

    .home-tags{margin-bottom:34px}.home-tags h2{display:flex;align-items:center;gap:12px;margin:0 0 18px;font-size:25px;line-height:1.25;letter-spacing:-.055em}.home-tags h2::after{height:1px;flex:1;background:var(--journal-line);content:''}.home-tags .post-tags{flex-wrap:wrap;margin:0;overflow:visible}.home-tags .post-tags button{padding:8px 11px}.home-tags .post-tags .post-tags-toggle{display:grid;place-items:center;min-width:34px;border-color:var(--journal-blue);background:#fff;color:var(--journal-blue);font-size:18px;font-weight:500;line-height:1}.home-tags .post-tags .post-tags-toggle:hover{background:#f3f6ff}.home-tags .post-tags .post-tags-toggle:focus-visible{outline:2px solid var(--journal-blue);outline-offset:2px}@media(max-width:1050px){.home-tags{margin-bottom:0}}@media(max-width:700px){.home-tags{margin-bottom:28px}}
  </style>
</BaseLayout>
