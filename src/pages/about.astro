---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteFooter from '../components/SiteFooter.astro';
import SiteHeader from '../components/SiteHeader.astro';
---

<BaseLayout title="소개 — 여백의 기록" description="여백의 기록 소개 페이지">
  <SiteHeader />
  <main id="top">
    <section class="coming-soon" aria-labelledby="coming-soon-title">
      <p class="eyebrow">ABOUT</p>
      <h1 id="coming-soon-title">준비중입니다.</h1>
      <p>소개 페이지를 천천히 정리하고 있어요.</p>
      <a class="text-link" href="/#writing">글 보러 가기 <span aria-hidden="true">↗</span></a>
    </section>
  </main>
  <SiteFooter />
</BaseLayout>
