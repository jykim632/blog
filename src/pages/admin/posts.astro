---
import BaseLayout from '../../layouts/BaseLayout.astro';
import AdminSidebar from '../../components/admin/AdminSidebar.astro';
---

<BaseLayout title="글 관리 — 파랑새들의 둥지" description="블로그 글을 작성하고 발행하는 관리자 화면" bodyClass="admin-posts-page">
  <main class="admin-shell">
    <AdminSidebar active="posts" />

    <section class="admin-workspace">
      <header class="admin-workspace-header">
        <div><p>CONTENT DESK</p><h1>글 관리</h1></div>
        <button type="button" data-new-post><span aria-hidden="true">+</span> 새 글</button>
      </header>
      <div class="admin-posts-layout">
      <aside class="admin-post-list" aria-label="글 목록">
        <div class="admin-list-head"><strong>글 목록</strong><span data-post-count>불러오는 중</span></div>
        <div class="admin-filters" role="group" aria-label="글 상태 필터">
          <button type="button" class="is-active" data-filter="all">전체</button><button type="button" data-filter="draft">초안</button><button type="button" data-filter="published">발행됨</button><button type="button" data-filter="archived">보관됨</button>
        </div>
        <div data-post-list class="admin-post-items" aria-live="polite"></div>
      </aside>

      <section class="admin-editor" aria-label="글 편집기">
        <div class="admin-editor-empty" data-empty-state><strong>글을 선택하세요.</strong><p>새 글을 만들거나 목록에서 편집할 글을 선택할 수 있습니다.</p></div>
        <form data-post-form hidden>
          <div class="admin-editor-bar"><span data-editor-status>새 초안</span><div><button type="button" class="secondary" data-archive>보관</button><button type="button" class="secondary" data-save>저장</button><button type="button" class="primary" data-publish>발행</button></div></div>
          <label>제목<input name="title" maxlength="90" required placeholder="글 제목" /></label>
          <section class="admin-tiptap" aria-label="본문 편집기">
            <div class="admin-tiptap-toolbar" role="toolbar" aria-label="본문 서식"><button type="button" data-editor-action="bold" aria-label="굵게"><strong>B</strong></button><button type="button" data-editor-action="italic" aria-label="기울임"><em>I</em></button><button type="button" data-editor-action="strike" aria-label="취소선"><s>S</s></button><i></i><button type="button" data-editor-action="heading">제목</button><button type="button" data-editor-action="bulletList">목록</button><button type="button" data-editor-action="orderedList">번호</button><button type="button" data-editor-action="blockquote">인용</button><button type="button" data-editor-action="codeBlock">코드</button></div>
            <div data-tiptap-editor></div>
          </section>
          <details class="admin-post-details"><summary>글 정보 <span>카테고리, 요약, 태그, 주소</span></summary><div class="admin-post-details-body"><div class="admin-meta-grid"><label>카테고리<select name="categoryId" required data-category-select></select></label><label>주소<input name="slug" maxlength="120" placeholder="자동 생성" pattern="[a-z0-9]+(-[a-z0-9]+)*" /></label></div><label>요약<textarea name="summary" maxlength="240" rows="2" placeholder="목록과 공유 화면에 표시할 짧은 소개"></textarea></label><label>태그 <span>쉼표로 구분</span><input name="tags" maxlength="480" placeholder="기록, 도구, 생각" /></label><label>표지 이미지 URL <span>선택 사항</span><input name="coverImageUrl" type="url" placeholder="https://…" /></label></div></details>
          <p class="admin-feedback" data-feedback aria-live="polite"></p>
        </form>
      </section>
      </div>
    </section>
  </main>

  <script>
    import { Editor, type JSONContent } from '@tiptap/core';
    import StarterKit from '@tiptap/starter-kit';

    type Status = 'draft'|'published'|'archived';
    type Category = { id:string; name:string };
    type Post = { id:string; title:string; slug:string; summary:string; status:Status; categoryId:string|null; categoryName:string|null; tags:string[]; publishedAt:string|null; updatedAt:string; contentJson?:Doc; coverImageUrl?:string|null };
    type Doc = JSONContent;
    type ApiResult<T> = { ok:true; data:T } | { ok:false; error:{code:string;message:string;fields?:Record<string,string>} };
    const list = document.querySelector<HTMLElement>('[data-post-list]')!;
    const count = document.querySelector<HTMLElement>('[data-post-count]')!;
    const form = document.querySelector<HTMLFormElement>('[data-post-form]')!;
    const empty = document.querySelector<HTMLElement>('[data-empty-state]')!;
    const feedback = document.querySelector<HTMLElement>('[data-feedback]')!;
    const categorySelect = document.querySelector<HTMLSelectElement>('[data-category-select]')!;
    const editorStatus = document.querySelector<HTMLElement>('[data-editor-status]')!;
    const editor = new Editor({ element:document.querySelector<HTMLElement>('[data-tiptap-editor]')!, extensions:[StarterKit.configure({ heading:{ levels:[1,2,3] } })], content:{ type:'doc', content:[{ type:'paragraph' }] }, editorProps:{ attributes:{ class:'admin-tiptap-content' } } });
    let posts: Post[] = []; let categories: Category[] = []; let selected: Post | null = null; let filter: 'all'|Status = 'all';
    const request = async <T,>(url:string, init?:RequestInit):Promise<T> => { const result = await fetch(url, { headers:{'Content-Type':'application/json', ...(init?.headers ?? {})}, ...init }); const raw = await result.text(); let body:ApiResult<T>; try { body = JSON.parse(raw) as ApiResult<T>; } catch { throw new Error('관리자 API 응답이 HTML입니다. Astro 개발 서버가 아닌 Cloudflare Pages 개발 서버에서 실행하거나, Pages Functions를 포함해 다시 배포해 주세요.'); } if (!body.ok) throw new Error(body.error.message); return body.data; };
    const statusLabel = (status:Status) => ({ draft:'초안', published:'발행됨', archived:'보관됨' })[status];
    function renderList() { const items = filter === 'all' ? posts : posts.filter((post) => post.status === filter); count.textContent = `${posts.length}개의 글`; list.replaceChildren(...items.map((post) => { const button=document.createElement('button'); button.type='button'; button.className=`admin-post-item${selected?.id===post.id?' is-selected':''}`; button.innerHTML=`<span>${statusLabel(post.status)}</span><strong></strong><small>${post.categoryName ?? '카테고리 없음'} · ${new Intl.DateTimeFormat('ko-KR',{month:'short',day:'numeric'}).format(new Date(post.updatedAt))}</small>`; button.querySelector('strong')!.textContent=post.title; button.addEventListener('click',()=>void openPost(post.id)); return button; })); if (!items.length) list.innerHTML='<p class="admin-list-empty">이 상태의 글이 없습니다.</p>'; }
    function showPost(post:Post) { selected=post; empty.hidden=true; form.hidden=false; form.elements.namedItem('title') && ((form.elements.namedItem('title') as HTMLInputElement).value=post.title); (form.elements.namedItem('summary') as HTMLTextAreaElement).value=post.summary; (form.elements.namedItem('categoryId') as HTMLSelectElement).value=post.categoryId ?? ''; (form.elements.namedItem('slug') as HTMLInputElement).value=post.slug; (form.elements.namedItem('tags') as HTMLInputElement).value=post.tags.join(', '); (form.elements.namedItem('coverImageUrl') as HTMLInputElement).value=post.coverImageUrl ?? ''; editor.commands.setContent(post.contentJson ?? { type:'doc', content:[{ type:'paragraph' }] }); editorStatus.textContent=statusLabel(post.status); feedback.textContent=''; renderList(); }
    async function openPost(id:string) { try { const post=await request<Post>(`/api/admin/posts/${id}`); const index=posts.findIndex((item)=>item.id===id); if(index>=0) posts[index]=post; else posts.unshift(post); showPost(post); } catch(cause) { form.hidden=true; empty.hidden=false; empty.querySelector('strong')!.textContent='글을 열지 못했습니다.'; empty.querySelector('p')!.textContent=cause instanceof Error?cause.message:'글을 불러오지 못했습니다.'; } }
    function newPost() { selected=null; empty.hidden=true; form.hidden=false; form.reset(); categorySelect.value=categories[0]?.id ?? ''; editor.commands.clearContent(); editorStatus.textContent='새 초안'; feedback.textContent=''; renderList(); (form.elements.namedItem('title') as HTMLInputElement).focus(); }
    function payload() { const values=new FormData(form); const cover=String(values.get('coverImageUrl') ?? '').trim(); return { title:String(values.get('title') ?? '').trim(), summary:String(values.get('summary') ?? '').trim(), categoryId:String(values.get('categoryId') ?? ''), slug:String(values.get('slug') ?? '').trim() || undefined, tags:String(values.get('tags') ?? '').split(',').map((tag)=>tag.trim()).filter(Boolean), coverImageUrl:cover || null, contentJson:editor.getJSON() }; }
    async function save() { const input=payload(); if (!input.title || !input.categoryId || !editor.getText().trim()) { feedback.textContent='제목, 카테고리, 본문을 입력해 주세요.'; return null; } try { feedback.textContent='저장 중…'; const post=selected ? await request<Post>(`/api/admin/posts/${selected.id}`,{method:'PATCH',body:JSON.stringify(input)}) : await request<Post>('/api/admin/posts',{method:'POST',body:JSON.stringify(input)}); const index=posts.findIndex((item)=>item.id===post.id); if(index===-1) posts.unshift(post); else posts[index]=post; showPost(post); feedback.textContent='저장했습니다.'; return post; } catch(cause) { feedback.textContent=cause instanceof Error?cause.message:'저장하지 못했습니다.'; return null; } }
    async function transition(action:'publish'|'archive') { const post=await save(); if(!post) return; try { const updated=await request<Post>(`/api/admin/posts/${post.id}/${action}`,{method:'POST',body:'{}'}); posts[posts.findIndex((item)=>item.id===updated.id)]=updated; showPost(updated); feedback.textContent=action==='publish'?'발행했습니다.':'보관했습니다.'; } catch(cause) { feedback.textContent=cause instanceof Error?cause.message:'상태를 변경하지 못했습니다.'; } }
    async function load() { try { const data=await request<{items:Post[];categories:Category[]}>('/api/admin/posts'); posts=data.items; categories=data.categories; categorySelect.replaceChildren(...categories.map((category)=>{const option=document.createElement('option');option.value=category.id;option.textContent=category.name;return option;})); renderList(); const id=new URLSearchParams(location.search).get('id'); if(id) await openPost(id); } catch(cause) { list.textContent=cause instanceof Error?cause.message:'글 목록을 불러오지 못했습니다.'; } }
    document.querySelector('[data-new-post]')!.addEventListener('click',newPost); document.querySelector('[data-save]')!.addEventListener('click',()=>void save()); document.querySelector('[data-publish]')!.addEventListener('click',()=>void transition('publish')); document.querySelector('[data-archive]')!.addEventListener('click',()=>void transition('archive')); document.querySelectorAll<HTMLButtonElement>('[data-editor-action]').forEach((button)=>button.addEventListener('click',()=>{ const action=button.dataset.editorAction; const chain=editor.chain().focus(); if(action==='bold') chain.toggleBold().run(); if(action==='italic') chain.toggleItalic().run(); if(action==='strike') chain.toggleStrike().run(); if(action==='heading') chain.toggleHeading({ level:2 }).run(); if(action==='bulletList') chain.toggleBulletList().run(); if(action==='orderedList') chain.toggleOrderedList().run(); if(action==='blockquote') chain.toggleBlockquote().run(); if(action==='codeBlock') chain.toggleCodeBlock().run(); }));
    document.querySelectorAll<HTMLButtonElement>('[data-filter]').forEach((button)=>button.addEventListener('click',()=>{filter=button.dataset.filter as typeof filter; document.querySelectorAll('[data-filter]').forEach((item)=>item.classList.toggle('is-active',item===button)); renderList();})); form.addEventListener('submit',(event)=>{event.preventDefault();void save();}); load();
  </script>

  <style is:global>
    .admin-posts-page{background:#f1f3ef;color:#18211f;font-family:'Pretendard Variable',Pretendard,sans-serif}.admin-workspace{min-width:0;padding:0 42px 54px}.admin-workspace-header{display:flex;align-items:end;justify-content:space-between;padding:44px 0 32px;border-bottom:1px solid #ced3cc}.admin-workspace-header p{margin:0 0 8px;color:#6c7972;font:700 10px/1 ui-monospace,SFMono-Regular,monospace;letter-spacing:.13em}.admin-workspace h1{margin:0;font-size:38px;line-height:1;letter-spacing:-.07em}.admin-workspace-header>button,.admin-editor-bar button{border:0;border-radius:8px;padding:11px 15px;background:#3159d9;color:#fff;font:700 13px inherit;cursor:pointer;box-shadow:0 3px 0 #203d9f}.admin-workspace-header>button:hover{background:#274ec8}.admin-workspace-header>button span{margin-right:5px;font-size:17px}.admin-posts-layout{display:grid;grid-template-columns:286px minmax(0,1fr);min-height:calc(100vh - 153px)}.admin-post-list{padding:27px 25px 30px 0;border-right:1px solid #ced3cc}.admin-list-head{display:flex;align-items:baseline;justify-content:space-between}.admin-list-head strong{font-size:14px}.admin-list-head span{color:#77817b;font-size:11px}.admin-filters{display:flex;gap:4px;margin:20px 0 15px;overflow:auto}.admin-filters button{flex:none;border:0;border-radius:999px;background:transparent;padding:7px 9px;color:#68736e;font:12px inherit;cursor:pointer}.admin-filters button.is-active{background:#dce3dd;color:#18211f;font-weight:700}.admin-post-items{display:grid;gap:4px}.admin-post-item{display:grid;width:100%;gap:5px;border:0;border-left:2px solid transparent;background:transparent;padding:12px 10px;text-align:left;color:inherit;cursor:pointer}.admin-post-item:hover{background:#e8ece7}.admin-post-item.is-selected{border-left-color:#3159d9;background:#e1e8fb}.admin-post-item span{color:#69736d;font-size:10px;font-weight:700}.admin-post-item strong{overflow:hidden;font-size:14px;text-overflow:ellipsis;white-space:nowrap}.admin-post-item small{color:#79837e;font-size:11px}.admin-list-empty{padding:24px 10px;color:#77817b;font-size:13px}.admin-editor{padding:27px 0 64px 54px}.admin-editor-empty{padding-top:18vh;color:#64716a}.admin-editor-empty strong{display:block;color:#18211f;font-size:25px;letter-spacing:-.06em}.admin-editor-empty p{font-size:15px}.admin-editor form{max-width:760px}.admin-editor-bar{display:flex;align-items:center;justify-content:space-between;margin-bottom:36px;padding-bottom:17px;border-bottom:1px solid #d5dad4;color:#68736e;font:700 11px ui-monospace,SFMono-Regular,monospace;letter-spacing:.05em}.admin-editor-bar>div{display:flex;gap:8px}.admin-editor-bar .secondary{border:1px solid #cbd1cb;background:#f8faf7;color:#3d4842;box-shadow:none}.admin-editor-bar .primary{background:#3159d9}.admin-editor label{display:block;margin-top:22px;color:#4e5a54;font-size:12px;font-weight:700}.admin-editor label span{font-weight:400;color:#89928c}.admin-editor input,.admin-editor textarea,.admin-editor select{display:block;width:100%;margin-top:8px;border:1px solid #cbd2ca;border-radius:7px;background:#fbfcfa;padding:11px 12px;color:#18211f;font:15px/1.55 inherit;outline:none}.admin-editor input:focus,.admin-editor textarea:focus,.admin-editor select:focus{border-color:#3159d9;box-shadow:0 0 0 3px rgba(49,89,217,.13)}.admin-editor textarea{resize:vertical}.admin-editor label:first-of-type input{border:0;border-bottom:2px solid #b8c1ba;border-radius:0;background:transparent;padding:6px 0 10px;font-size:34px;font-weight:750;line-height:1.22;letter-spacing:-.065em}.admin-tiptap{margin-top:23px;border:1px solid #cbd2ca;border-radius:8px;background:#fff;overflow:hidden}.admin-tiptap-toolbar{display:flex;align-items:center;gap:3px;overflow:auto;border-bottom:1px solid #d9ded8;padding:8px}.admin-tiptap-toolbar button{flex:none;border:0;border-radius:5px;background:transparent;padding:7px 9px;color:#3e4943;font:700 12px 'Pretendard Variable',Pretendard,sans-serif;cursor:pointer}.admin-tiptap-toolbar button:hover{background:#e5ebe5}.admin-tiptap-toolbar i{width:1px;height:18px;margin:0 3px;background:#d2d8d2}.admin-tiptap-content{min-height:460px;padding:26px;color:#18211f;font:16px/1.85 'Pretendard Variable',Pretendard,sans-serif;outline:none}.admin-tiptap-content p{margin:0 0 1.2em}.admin-tiptap-content h2{margin:1.7em 0 .7em;font-size:1.55em;line-height:1.25}.admin-tiptap-content h3{margin:1.5em 0 .65em;font-size:1.25em}.admin-tiptap-content ul,.admin-tiptap-content ol{margin:0 0 1.2em;padding-left:1.5em}.admin-tiptap-content blockquote{margin:1.5em 0;border-left:3px solid #3159d9;padding:4px 0 4px 16px;color:#58645e}.admin-tiptap-content pre{overflow:auto;margin:1.5em 0;border-radius:6px;background:#18211f;padding:16px;color:#e9f2ec;font:13px/1.6 ui-monospace,SFMono-Regular,monospace}.admin-tiptap-content.ProseMirror-focused{box-shadow:inset 0 0 0 2px rgba(49,89,217,.18)}.admin-post-details{margin-top:18px;border-top:1px solid #d5dad4}.admin-post-details summary{cursor:pointer;padding:16px 0;color:#4e5a54;font-size:13px;font-weight:700}.admin-post-details summary span{margin-left:8px;color:#89928c;font-weight:400}.admin-post-details-body{padding:0 0 16px}.admin-meta-grid{display:grid;grid-template-columns:1fr 1fr;gap:16px}.admin-feedback{min-height:20px;margin:14px 0;color:#536059;font-size:13px}@media(max-width:860px){.admin-workspace{padding:0 26px}.admin-posts-layout{grid-template-columns:240px minmax(0,1fr)}.admin-editor{padding-left:32px}}@media(max-width:650px){.admin-workspace{padding:0 20px 42px}.admin-workspace-header{padding:28px 0 24px}.admin-workspace h1{font-size:31px}.admin-posts-layout{display:block}.admin-post-list{padding-right:0;border-right:0;border-bottom:1px solid #ced3cc}.admin-post-items{grid-template-columns:repeat(2,minmax(0,1fr));max-height:245px;overflow:auto}.admin-editor{padding:32px 0}.admin-editor-empty{padding-top:52px}.admin-meta-grid{grid-template-columns:1fr}.admin-editor-bar{align-items:start;gap:12px}.admin-editor-bar>div{flex-wrap:wrap;justify-content:end}.admin-editor label:first-of-type input{font-size:27px}.admin-tiptap-content{min-height:340px;padding:20px}.admin-post-details summary span{display:none}}
  </style>
  <style is:global>
    .admin-posts-page{background:#fff;color:var(--bnb-ink,#222);font-family:"Airbnb Cereal VF",Circular,-apple-system,system-ui,sans-serif}.admin-workspace{width:min(100%,1280px);margin:auto;padding:0 24px 56px}.admin-workspace-header{padding:40px 0 28px;border-color:var(--bnb-line,#ddd)}.admin-workspace-header p{color:var(--bnb-muted,#6a6a6a);font:14px/1.3 inherit;letter-spacing:0}.admin-workspace h1{font-size:28px;font-weight:700;letter-spacing:-.44px}.admin-workspace-header>button,.admin-editor-bar .primary{background:var(--bnb,#ff385c);box-shadow:none}.admin-workspace-header>button:hover,.admin-editor-bar .primary:hover{background:var(--bnb-active,#e00b41)}.admin-post-list{border-color:var(--bnb-line,#ddd)}.admin-post-item.is-selected{border-left-color:var(--bnb,#ff385c);background:var(--bnb-soft,#f7f7f7)}.admin-post-item:hover{background:var(--bnb-soft,#f7f7f7)}.admin-editor-bar .secondary{border-color:var(--bnb-ink,#222);background:#fff;color:var(--bnb-ink,#222)}.admin-editor input:focus,.admin-editor textarea:focus,.admin-editor select:focus{border-color:var(--bnb-ink,#222);box-shadow:0 0 0 1px var(--bnb-ink,#222)}.admin-tiptap{border-color:var(--bnb-line,#ddd);border-radius:14px}.admin-tiptap-toolbar{border-color:var(--bnb-line,#ddd)}.admin-tiptap-toolbar button:hover{background:var(--bnb-soft,#f7f7f7)}.admin-tiptap-content blockquote{border-color:var(--bnb,#ff385c)}.admin-tiptap-content.ProseMirror-focused{box-shadow:inset 0 0 0 2px var(--bnb-ink,#222)}.admin-post-details{border-color:var(--bnb-line,#ddd)}
  </style>
</BaseLayout>
