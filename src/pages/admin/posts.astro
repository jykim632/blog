---
import BaseLayout from '../../layouts/BaseLayout.astro';
import AdminSidebar from '../../components/admin/AdminSidebar.astro';
---

<BaseLayout title="글 관리 — 파랑새들의 둥지" description="블로그 글 목록을 관리하는 관리자 화면" bodyClass="admin-posts-page">
  <main class="admin-shell">
    <AdminSidebar active="posts" />
    <section class="admin-workspace">
      <header class="admin-workspace-header">
        <div><p>CONTENT DESK</p><h1>글 관리</h1></div>
        <a class="admin-primary-action" href="/admin/posts/new"><span aria-hidden="true">+</span> 새 글</a>
      </header>

      <section class="admin-post-index" aria-label="글 목록">
        <div class="admin-list-head"><div><h2>글 목록</h2><p data-post-count>불러오는 중</p></div><div class="admin-list-controls"><label class="admin-search"><span class="sr-only">글 검색</span><input type="search" data-post-search placeholder="제목, 요약, 태그 검색" /></label><label class="admin-sort"><span class="sr-only">작성일 정렬</span><select data-post-sort><option value="newest">작성일 최신순</option><option value="oldest">작성일 오래된순</option></select></label></div></div>
        <div class="admin-filters" role="group" aria-label="글 상태 필터">
          <button type="button" class="is-active" data-filter="all">전체</button><button type="button" data-filter="draft">초안</button><button type="button" data-filter="published">발행됨</button><button type="button" data-filter="archived">보관됨</button>
        </div>
        <div class="admin-tag-filters" data-tag-filters aria-label="태그 필터"></div>
        <div data-post-list class="admin-post-items" aria-live="polite"></div>
      </section>
    </section>
  </main>

  <script>
    type Status = 'draft'|'published'|'archived';
    type Post = { id:string; title:string; slug:string; summary:string; status:Status; categoryName:string|null; tags:string[]; publishedAt:string|null; updatedAt:string };
    type ApiResult<T> = { ok:true; data:T } | { ok:false; error:{code:string;message:string} };
    const list = document.querySelector<HTMLElement>('[data-post-list]')!;
    const count = document.querySelector<HTMLElement>('[data-post-count]')!;
    const search = document.querySelector<HTMLInputElement>('[data-post-search]')!;
    const sort = document.querySelector<HTMLSelectElement>('[data-post-sort]')!;
    const tagFilters = document.querySelector<HTMLElement>('[data-tag-filters]')!;
    let posts: Post[] = [];
    let filter: 'all'|Status = 'all';
    let selectedTag = 'all';
    const statusLabel = (status:Status) => ({ draft:'초안', published:'발행됨', archived:'보관됨' })[status];
    const request = async <T,>(url:string):Promise<T> => { const response=await fetch(url); const body=await response.json() as ApiResult<T>; if(!body.ok) throw new Error(body.error.message); return body.data; };
    const displayDate=(post:Post)=>new Date(post.publishedAt ?? post.updatedAt); const dateLabel=(post:Post)=>post.publishedAt?'발행':'수정';
    function renderTags() { const tags=[...new Set(posts.flatMap(post=>post.tags))].sort((left,right)=>left.localeCompare(right,'ko')); tagFilters.replaceChildren(...['all',...tags].map(tag=>{const button=document.createElement('button');button.type='button';button.className=tag===selectedTag?'is-active':'';button.textContent=tag==='all'?'모든 태그':`# ${tag}`;button.addEventListener('click',()=>{selectedTag=tag;renderList();renderTags();});return button;})); }
    function renderList() { const query=search.value.trim().toLowerCase(); const items=posts.filter((post)=> (filter==='all'||post.status===filter) && (selectedTag==='all'||post.tags.includes(selectedTag)) && (!query || [post.title,post.summary,post.categoryName ?? '',...post.tags].join(' ').toLowerCase().includes(query))).sort((left,right)=>{const difference=displayDate(right).getTime()-displayDate(left).getTime();return sort.value==='newest'?difference:-difference;}); count.textContent=`${items.length}개 표시 · 전체 ${posts.length}개`; list.replaceChildren(...items.map((post)=>{ const link=document.createElement('a'); link.className='admin-post-item'; link.href=`/admin/posts/${post.id}`; const meta=document.createElement('small'); meta.textContent=`${post.categoryName ?? '카테고리 없음'} · ${dateLabel(post)} ${new Intl.DateTimeFormat('ko-KR',{year:'numeric',month:'short',day:'numeric'}).format(displayDate(post))}`; const tags=document.createElement('div'); tags.className='admin-post-tags'; post.tags.slice(0,4).forEach(tag=>{const chip=document.createElement('span');chip.textContent=`# ${tag}`;tags.append(chip);}); link.innerHTML=`<span>${statusLabel(post.status)}</span><strong></strong><p></p>`; link.querySelector('strong')!.textContent=post.title; link.querySelector('p')!.textContent=post.summary||'요약이 없습니다.'; link.append(meta,tags); return link; })); if(!items.length) list.innerHTML='<p class="admin-list-empty">조건에 맞는 글이 없습니다.</p>'; }
    async function load() { try { const data=await request<{items:Post[]}>('/api/admin/posts'); posts=data.items; renderTags(); renderList(); } catch(cause) { list.textContent=cause instanceof Error?cause.message:'글 목록을 불러오지 못했습니다.'; } }
    search.addEventListener('input',renderList); sort.addEventListener('change',renderList); document.querySelectorAll<HTMLButtonElement>('[data-filter]').forEach((button)=>button.addEventListener('click',()=>{filter=button.dataset.filter as typeof filter; document.querySelectorAll('[data-filter]').forEach((item)=>item.classList.toggle('is-active',item===button)); renderList();})); load();
  </script>

  <style is:global>
    .admin-posts-page{background:#fff;color:var(--bnb-ink,#222);font-family:"Airbnb Cereal VF",Circular,-apple-system,system-ui,sans-serif}.admin-workspace{width:min(100%,1280px);margin:auto;padding:0 24px 56px}.admin-workspace-header{display:flex;align-items:end;justify-content:space-between;padding:40px 0 28px;border-bottom:1px solid var(--bnb-line,#ddd)}.admin-workspace-header p{margin:0 0 8px;color:var(--bnb-muted,#6a6a6a);font:14px/1.3 inherit}.admin-workspace h1{margin:0;font-size:28px;font-weight:700;letter-spacing:-.44px}.admin-primary-action{border-radius:8px;padding:11px 15px;background:var(--bnb,#ff385c);color:#fff;font-size:13px;font-weight:700;text-decoration:none}.admin-primary-action:hover{background:var(--bnb-active,#e00b41)}.admin-primary-action span{margin-right:5px;font-size:17px}.admin-post-index{padding:34px 0}.admin-list-head{display:flex;align-items:center;justify-content:space-between;gap:18px}.admin-list-head h2{margin:0;font-size:18px}.admin-list-head p{margin:5px 0 0;color:var(--bnb-muted,#6a6a6a);font-size:13px}.admin-list-controls{display:flex;gap:8px}.admin-search{width:min(100%,290px)}.admin-search input,.admin-sort select{box-sizing:border-box;width:100%;border:1px solid var(--bnb-line,#ddd);border-radius:8px;padding:10px 12px;background:#fff;font:14px inherit}.admin-sort select{width:auto;color:var(--bnb-ink,#222)}.admin-search input:focus,.admin-sort select:focus{outline:2px solid var(--bnb-ink,#222);outline-offset:1px}.admin-filters,.admin-tag-filters{display:flex;gap:5px;overflow:auto}.admin-filters{margin:25px 0 10px}.admin-tag-filters{margin:0 0 22px;padding-bottom:2px}.admin-filters button,.admin-tag-filters button{flex:none;border:1px solid transparent;border-radius:999px;background:transparent;padding:8px 11px;color:var(--bnb-muted,#6a6a6a);font:13px inherit;cursor:pointer}.admin-filters button.is-active,.admin-tag-filters button.is-active{border-color:var(--bnb-ink,#222);color:var(--bnb-ink,#222);font-weight:700}.admin-tag-filters button{background:var(--bnb-soft,#f7f7f7)}.admin-post-items{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:14px}.admin-post-item{display:flex;min-height:185px;flex-direction:column;align-items:flex-start;gap:9px;border:1px solid var(--bnb-line,#ddd);border-radius:14px;padding:18px;color:inherit;text-decoration:none}.admin-post-item:hover{border-color:var(--bnb-ink,#222);box-shadow:0 3px 10px rgba(0,0,0,.06)}.admin-post-item>span{color:var(--bnb,#ff385c);font-size:11px;font-weight:700}.admin-post-item strong{font-size:17px;line-height:1.35}.admin-post-item p{display:-webkit-box;overflow:hidden;margin:0;color:var(--bnb-muted,#6a6a6a);font-size:13px;line-height:1.55;-webkit-box-orient:vertical;-webkit-line-clamp:2}.admin-post-item small{margin-top:auto;color:var(--bnb-muted,#6a6a6a);font-size:11px}.admin-post-tags{display:flex;flex-wrap:wrap;gap:5px}.admin-post-tags span{border-radius:999px;background:var(--bnb-soft,#f7f7f7);padding:4px 7px;color:var(--bnb-muted,#6a6a6a);font-size:11px}.admin-list-empty{grid-column:1/-1;padding:32px 0;color:var(--bnb-muted,#6a6a6a)}.sr-only{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0,0,0,0)}@media(max-width:900px){.admin-post-items{grid-template-columns:repeat(2,minmax(0,1fr))}}@media(max-width:650px){.admin-workspace{padding:0 20px 42px}.admin-workspace-header{padding:28px 0 24px}.admin-workspace h1{font-size:31px}.admin-list-head{align-items:stretch;flex-direction:column}.admin-list-controls{flex-direction:column}.admin-search{width:100%}.admin-sort select{width:100%}.admin-post-items{grid-template-columns:1fr}}
  </style>
</BaseLayout>
