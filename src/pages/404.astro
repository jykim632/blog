---
import SiteFooter from '../components/SiteFooter.astro';
import SiteHeader from '../components/SiteHeader.astro';
import BaseLayout from '../layouts/BaseLayout.astro';

Astro.response.status = 404;
---

<BaseLayout
  title="페이지를 찾을 수 없습니다 — 파랑새들의 둥지"
  description="요청한 페이지가 없거나 주소가 변경되었습니다."
  bodyClass="not-found-page"
>
  <SiteHeader />
  <main class="not-found" id="top">
    <p>404</p>
    <h1>페이지를 찾을 수 없습니다.</h1>
    <p>주소가 변경되었거나 존재하지 않는 페이지입니다.</p>
    <div>
      <a href="/">홈으로 가기</a>
      <a href="/posts">모든 글 보기</a>
    </div>
  </main>
  <SiteFooter />
</BaseLayout>

<style>
  .not-found {
    width: min(100% - 48px, 720px);
    min-height: 55vh;
    margin: 0 auto;
    padding: 120px 0;
  }

  .not-found > p:first-child {
    color: var(--bnb-blue, #3567e8);
    font-size: 0.9rem;
    font-weight: 800;
    letter-spacing: 0.12em;
  }

  .not-found h1 { margin: 12px 0; font-size: clamp(2rem, 6vw, 3.5rem); }
  .not-found > p:not(:first-child) { color: var(--bnb-muted, #687084); }
  .not-found div { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 32px; }
  .not-found a { border: 1px solid var(--bnb-line, #d7dbe4); border-radius: 999px; color: inherit; font-weight: 700; padding: 11px 16px; text-decoration: none; }
  .not-found a:first-child { background: var(--bnb-blue, #3567e8); border-color: var(--bnb-blue, #3567e8); color: white; }
</style>
