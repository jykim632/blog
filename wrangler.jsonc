{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "blog",
  "compatibility_date": "2026-07-18",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": true,
  "routes": [
    {
      "pattern": "bluebirds.cloud",
      "custom_domain": true
    }
  ],
  "observability": {
    "enabled": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "blog",
      "database_id": "9f5c594e-531e-4587-8ce1-8c5fca6506fd",
      "migrations_dir": "db/migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA_BUCKET",
      "bucket_name": "bluebirds-media"
    }
  ],
  "vars": {
    "MEDIA_PUBLIC_URL": "https://media.bluebirds.cloud",
    "MEDIA_ACCESS_AUD": "385a95e44c1643ab0a9885b8cc572bfe89c09d61abc2c000235a190f9705c65e",
    "MEDIA_ACCESS_TEAM_DOMAIN": "https://long-disk-2ff5.cloudflareaccess.com",
    "MEDIA_ACCESS_EMAIL": "jykim632@gmail.com"
  },
  "env": {
    "develop": {
      "name": "blog-develop",
      "routes": [
        {
          "pattern": "develop.bluebirds.cloud",
          "custom_domain": true
        }
      ],
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "blog-develop",
          "database_id": "09020bc1-858f-4acc-8a8d-acb587897d34",
          "migrations_dir": "db/migrations"
        }
      ],
      "r2_buckets": [
        {
          "binding": "MEDIA_BUCKET",
          "bucket_name": "bluebirds-media-develop"
        }
      ],
      "vars": {
        "MEDIA_ACCESS_AUD": "385a95e44c1643ab0a9885b8cc572bfe89c09d61abc2c000235a190f9705c65e",
        "MEDIA_PUBLIC_URL": "https://media-develop.bluebirds.cloud",
        "MEDIA_ACCESS_TEAM_DOMAIN": "https://long-disk-2ff5.cloudflareaccess.com",
        "MEDIA_ACCESS_EMAIL": "jykim632@gmail.com"
      }
    }
  }
}
