{
  "name": "yeobaek-records",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@10.11.1",
  "scripts": {
    "dev": "astro dev",
    "build": "astro check && astro build",
    "preview": "astro preview",
    "cf:dev": "wrangler dev --config dist/server/wrangler.json",
    "deploy": "wrangler deploy --config dist/server/wrangler.json",
    "db:migrate:local": "wrangler d1 migrations apply blog --local",
    "db:migrate:remote": "wrangler d1 migrations apply blog --remote",
    "db:import:legacy": "node scripts/import-legacy-posts.mjs"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.1.3",
    "@tiptap/core": "^3.28.0",
    "@tiptap/starter-kit": "^3.28.0",
    "astro": "^7.1.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "typescript": "^5.8.0",
    "wrangler": "^4.25.0"
  }
}
